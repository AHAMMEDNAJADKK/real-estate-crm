# ==============================================================================
# KODBRAND ENTERPRISE ERP — REAL ESTATE CRM (BACKEND CONFIGURATION)
# ==============================================================================

# Server Network & Runtime Environment
# On Render: PORT is assigned automatically by the platform (e.g., 10000)
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas for production or Local MongoDB for development)
# Preferred variable: MONGODB_URI (MONGO_URI is also supported for backward compatibility)
# Local Development: mongodb://127.0.0.1:27017/realestate_crm
# Production (Render / Atlas): mongodb+srv://<username>:<password>@<cluster>.mongodb.net/realestate_crm?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/realestate_crm

# JWT Authentication (Must be a strong unique secret >= 32 chars in production)
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=7d

# CORS Allowed Origins
# Comma-separated list of allowed frontend origins (do not use * in production).
# For Vercel production: https://your-frontend.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173

