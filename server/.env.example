# ==============================================================================
# KODBRAND ENTERPRISE ERP — REAL ESTATE CRM (BACKEND CONFIGURATION)
# ==============================================================================

# Server Network & Runtime Environment
# On Render: PORT is assigned automatically by the platform (e.g., 10000)
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas or Local MongoDB)
# Local: mongodb://127.0.0.1:27017/realestate_crm
# Production (Render / Atlas): mongodb+srv://<username>:<password>@<cluster>.mongodb.net/realestate_crm?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/realestate_crm

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=7d

# CORS Allowed Origins
# Comma-separated list of allowed frontend origins.
# For Vercel production: https://your-app.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,https://your-frontend.vercel.app
